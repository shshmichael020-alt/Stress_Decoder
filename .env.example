# ============================================================================
# EXAM STRESS TRIANGLE LAB — ENVIRONMENT CONFIGURATION
# ============================================================================

# Supabase Public API URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for browser / client queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Secret Key (Server-side ONLY. NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mode: 'auto' | 'demo' | 'live'
# When credentials are unset, the application automatically operates in DEMO PREVIEW mode
# with N=412 verified illustrative cohort data clearly labeled.
NEXT_PUBLIC_APP_MODE=auto
